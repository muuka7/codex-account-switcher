{
  "name": "private-codex-account-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "Private, local-only Codex desktop account switcher with OS-backed credential protection.",
  "main": "src/main.js",
  "author": "muuka7",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "node --check src/main.js && node --check src/preload.js && node --check src/ui/app.js && node --check scripts/apply-fuses.js",
    "pack:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "pack:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.8.1",
    "@electron/fuses": "1.8.0"
  },
  "build": {
    "appId": "com.muuka.privatecodexswitcher",
    "productName": "Codex Account Switcher",
    "asar": true,
    "afterPack": "scripts/apply-fuses.js",
    "directories": { "output": "release" },
    "files": ["src/**/*", "scripts/apply-fuses.js", "README.md", "SECURITY.md", "LICENSE", "NOTICE.md", "package.json"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "artifactName": "CodexAccountSwitcher-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "CodexAccountSwitcher-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
