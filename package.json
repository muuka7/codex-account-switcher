{
  "name": "codex-account-switcher",
  "version": "0.2.2",
  "private": true,
  "description": "Codex desktop account switcher with OS-backed credential protection and usage visibility.",
  "main": "src/main.js",
  "author": "muuka7",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node src/server/cli.js",
    "server:install": "node scripts/install-server.js",
    "lint:server": "node scripts/check-server.js",
    "lint": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "pack:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "verify:release": "node scripts/verify-release.js"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.muuka.privatecodexswitcher",
    "productName": "Codex Account Switcher",
    "asar": true,
    "asarUnpack": [
      "node_modules/@openai/codex-*/vendor/**/*"
    ],
    "afterPack": "scripts/apply-fuses.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "!src/server/**/*",
      "README.md",
      "SECURITY.md",
      "docs/USAGE-MONITORING.md",
      "docs/LINUX-SERVER.md",
      "LICENSE",
      "NOTICE.md",
      "package.json",
      "!node_modules/@openai/codex-*/**/*",
      "licenses/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CodexAccountSwitcher-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "forceCodeSigning": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodexAccountSwitcher-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "muuka7",
      "repo": "codex-account-switcher",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@openai/codex": "0.136.0",
    "electron-updater": "6.8.9",
    "smol-toml": "1.9.1",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
