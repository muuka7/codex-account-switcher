{
  "name": "codex-account-switcher",
  "version": "0.2.1",
  "private": true,
  "description": "Codex desktop account switcher with OS-backed credential protection and usage visibility.",
  "main": "src/main.js",
  "author": "muuka7",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "node --check src/main.js && node --check src/codex-config.js && node --check src/codex-app-server.js && node --check src/rate-limits.js && node --check src/handoff-policy.js && node --check src/state-events.js && node --check src/preload.js && node --check src/ui/icons.js && node --check src/ui/app.js && node --check scripts/apply-fuses.js",
    "test": "node --test test/*.test.js",
    "pack:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "pack:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.muuka.privatecodexswitcher",
    "productName": "Codex Account Switcher",
    "asar": true,
    "asarUnpack": [
      "node_modules/@openai/codex-*/vendor/**/*"
    ],
    "afterPack": "scripts/apply-fuses.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "scripts/apply-fuses.js",
      "README.md",
      "SECURITY.md",
      "docs/**/*",
      "LICENSE",
      "NOTICE.md",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CodexAccountSwitcher-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodexAccountSwitcher-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@openai/codex": "0.136.0"
  }
}
